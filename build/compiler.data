	#for (var key in m.map) array_push(ret,m.map[key].key,false)

	return ret
}

pub fn (m map) values() array {
	ret := JS.makeEmptyArray()
	#for (var key in m.map) array_push(ret,m.map[key].val,false);

	return ret
}

