	} $else {
		res64 := i64(x) - i64(y)
		res = i8(res64)
		is_overflow = res64 > max_i8 || res64 < min_i8
	}
	if is_overflow {
		panic('attempt to sub with overflow(i8(${x}) - i8(${y}))')
	}
	return res
}

