// shl_i8 computes `x` << `n` for i8 values, and panic if `n` is negative or at least 8
@[inline]
fn shl_i8(x i8, n i64) i8 {
	if n < 0 || n >= 8 {
		panic('attempt to shl with overflow(i8(${x}) << ${n})')
	}
	return x << n
}

