pub fn uint8_array(arr []u8) JS.Uint8Array {
	#let tmp = new Array();

	for elem in arr {
		_ := elem
		#tmp.push(elem.val)
	}
	mut uint_arr := JS.Uint8Array{}
	#uint_arr = new Uint8Array(tmp)

	return uint_arr
}

