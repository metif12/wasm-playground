// shr_u8 computes `x` >> `n` for u8 values, and panic if `n` is negative or at least 8
@[inline]
fn shr_u8(x u8, n i64) u8 {
	if n < 0 || n >= 8 {
		panic('attempt to shr with overflow(u8(${x}) >> ${n})')
	}
	return x >> n
}

